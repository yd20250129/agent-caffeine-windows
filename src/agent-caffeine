#!/usr/bin/env bash
# agent-caffeine — エージェント稼働中だけスリープを抑止する（Windows Git Bash版）
#
# 設計の肝: 参照カウント方式 + daemon分離
#   Claude を worktree で並行稼働させるため、単純な ON/OFF フラグだと
#   片方のセッション終了で caffeinate を止めてしまい、もう片方が稼働中なのに
#   スリープしてしまう。そこで「holder（保持者）」をトークン単位で登録し、
#   holder が 1 つでも生きている間だけスリープ抑止を動かす。
#
#   スリープ抑止の実体はタスクスケジューラでログオン時起動される daemon.ps1。
#   agent-caffeine は holder ファイルの作成/削除のみを行い、プロセス起動には
#   関与しない。理由: Git Bash の `nohup powershell &` で切り離すと
#   インタラクティブデスクトップとの結び付きを失い SendKeys が silent-fail する。
#   タスクスケジューラの LogonTrigger + InteractiveToken 経由なら結び付きが
#   維持され、F15 / マウス微動が確実にOSのIdleTimerをリセットできる。
#
# 使い方:
#   agent-caffeine acquire [token]   # holder を登録（daemon が拾って抑止開始）
#   agent-caffeine release [token]   # holder を解除（holder=0 で daemon が抑止停止）
#   agent-caffeine status            # 状態と holder 一覧、daemon プロセス生存を表示
#   agent-caffeine reap              # 死んだ holder（数値PID消滅）を掃除
#   agent-caffeine janitor           # claude が皆無なら残存 holder を全消去（crash-leak 対策）
#
# token を省略すると呼び出し元の PPID を使う。Claude フックからは session_id など
# 「生きている間ユニーク」な値を渡すのが堅い。
# token が数値（PID）の場合のみ、reap でプロセス生存を検証して自動掃除する。
#
# 環境変数:
#   AGENT_CAFFEINE_STATE           状態ディレクトリ（default: ~/.local/state/agent-caffeine）
#   AGENT_CAFFEINE_CLAUDE_PATTERN  janitor の Claude 検出パターン（PowerShell Get-Process Path）
#   AGENT_CAFFEINE_JANITOR_GRACE   janitor が holder を消さずに猶予する秒数（default: 60）
#   AGENT_CAFFEINE_PGREP_BIN       テスト用。既定は pgrep

set -euo pipefail

STATE_DIR="${AGENT_CAFFEINE_STATE:-$HOME/.local/state/agent-caffeine}"
HOLDERS_DIR="$STATE_DIR/holders"
# daemon.ps1 が自身の PID を書き出すファイル。存在＆生存で daemon 稼働中とみなす。
DAEMON_PID_FILE="$STATE_DIR/daemon.pid"
# PS の -match は正規表現。Windows パスは `\` セパレータなので `/` を含めないこと。
# 旧デフォルト `win32-x64/claude` は絶対にマッチしなかった (Path=...anthropic.claude-code-*-win32-x64\resources\...).
# `claude-code.*win32-x64` はプロセスパスに含まれる安定した部分文字列。
CLAUDE_PATTERN="${AGENT_CAFFEINE_CLAUDE_PATTERN:-claude-code.*win32-x64}"
# janitor の安全弁: 作られてから GRACE 秒未満の holder は消さない。
# 検出パターンの誤判定や acquire 直後の取りこぼしで「全滅」と誤認しても、
# 起動直後の現役セッションを巻き込まないための保険。
JANITOR_GRACE="${AGENT_CAFFEINE_JANITOR_GRACE:-60}"

mkdir -p "$HOLDERS_DIR"

log() { printf '[agent-caffeine] %s\n' "$*" >&2; }

process_matches() {
  local pattern="$1"
  [ -n "$pattern" ] || return 1
  # -WindowStyle Hidden はコンソール表示を抑止する保険。janitor はさらに wscript+VBS
  # でラップされているため通常はコンソール自体が親から与えられないが、手動起動時や
  # 環境差で親コンソールが継承されると一瞬フラッシュするため念のため付ける。
  powershell.exe -NoProfile -WindowStyle Hidden -Command \
    "Get-Process | Where-Object { \$_.Path -match '$pattern' } | Select-Object -First 1" \
    2>/dev/null | grep -q .
}

# daemon.ps1 (タスクスケジューラで常駐) の生存確認。
# daemon が書いた PID は Windows のPID。Git Bash の `kill -0` は Windows PID を
# そのまま解釈できないため、PowerShell 経由で確認する。
daemon_running() {
  [ -f "$DAEMON_PID_FILE" ] || return 1
  local pid
  pid=$(cat "$DAEMON_PID_FILE" 2>/dev/null || true)
  [ -n "$pid" ] || return 1
  powershell.exe -NoProfile -WindowStyle Hidden -Command "if (Get-Process -Id $pid -ErrorAction SilentlyContinue) { exit 0 } else { exit 1 }" 2>/dev/null
}

# daemon 分離設計のため、agent-caffeine 側では起動/停止を行わない。
# holder を作れば daemon が次のポーリング (60秒) で拾って抑止を開始する。
# holder=0 になれば daemon が抑止を停止する（daemon プロセス自体は動き続ける）。
start_caffeinate() { :; }
stop_caffeinate() { :; }

# daemon が死んでいたらタスクスケジューラ経由で起こす。冪等 (既に生きていれば
# daemon.ps1 側で「already running, exiting」と判断して黙って抜ける)。
# 死因例: スリープ復帰時の強制終了、想定外の例外、手動 taskkill 等。
# janitor から holder>0 の状態で呼ばれることを想定している。
ensure_daemon() {
  if daemon_running; then return 0; fi
  # 古い pid ファイルが残っているとdaemon.ps1が起動を拒否するので消しておく
  rm -f "$DAEMON_PID_FILE"
  schtasks.exe //Run //TN "agent-caffeine-daemon" >/dev/null 2>&1 || true
  log "ensure_daemon: dead daemon detected, requested restart via Task Scheduler"
}

reap() {
  local f pid
  for f in "$HOLDERS_DIR"/*; do
    [ -e "$f" ] || continue
    pid=$(basename "$f")
    case "$pid" in
    *[!0-9]*) continue ;; # 数値でない token は生存検証できないので残す
    esac
    kill -0 "$pid" 2>/dev/null || rm -f "$f"
  done
}

count_holders() {
  reap
  find "$HOLDERS_DIR" -type f 2>/dev/null | wc -l | tr -d ' '
}

# claude が生きていれば 0（=稼働中）を返す。
# 空パターンは「検出無効」扱い。
agents_alive() {
  process_matches "$CLAUDE_PATTERN" && return 0
  return 1
}

# crash-leak 対策の安全網。
# ターン中に acquire したまま claude が異常終了すると、session_id のような
# 非数値 token は reap で消えず holder が残り caffeinate が動き続ける。
# そこで「claude が 1 つも生きていない」ときに限り、残存 holder を掃除して停止する。
# claude が生きている間は、他人の holder を巻き込まないよう一切触らない（過剰停止の防止）。
#
# 安全弁: 全滅と判定しても、作られてから JANITOR_GRACE 秒未満の holder は消さない。
# 検出パターンの誤判定や acquire 直後の取りこぼしで誤って「全滅」と見えても、
# 起動直後の現役セッションを巻き込まない。古い holder が残らなければ caffeinate を止める。
cmd_janitor() {
  reap # まず数値 token（PID 消滅）を通常掃除
  if agents_alive; then
    # claude 稼働中: holder>0 で daemon が死んでいたら復活させる。
    # daemon はスリープ復帰時の強制終了などで落ちることがあり、そのままだと
    # 承認待ちや長時間ターン中に再びスリープしてしまう。janitor が毎分回るので
    # 最大60秒で自己修復できる。
    if [ "$(count_holders)" -gt 0 ]; then
      ensure_daemon
    fi
    log "janitor: agents alive, holders=$(count_holders) (no-op)"
    return 0
  fi
  local purged=0 kept=0 now age f
  now=$(date +%s)
  for f in "$HOLDERS_DIR"/*; do
    [ -e "$f" ] || continue
    age=$((now - $(stat --format=%Y "$f")))
    if [ "$age" -ge "$JANITOR_GRACE" ]; then
      rm -f "$f"
      purged=$((purged + 1))
    else
      kept=$((kept + 1))
    fi
  done
  if [ "$(count_holders)" -eq 0 ]; then
    stop_caffeinate
    log "janitor: no agents alive, purged $purged leaked holder(s), caffeinate stopped"
  else
    log "janitor: no agents alive, purged $purged / kept $kept fresh holder(s) within ${JANITOR_GRACE}s grace"
  fi
}

cmd_acquire() {
  local token="${1:-$PPID}"
  : >"$HOLDERS_DIR/$token"
  start_caffeinate
  log "acquire token=$token holders=$(count_holders)"
}

cmd_release() {
  local token="${1:-$PPID}"
  rm -f "$HOLDERS_DIR/$token"
  if [ "$(count_holders)" -eq 0 ]; then
    stop_caffeinate
  fi
  log "release token=$token holders=$(count_holders)"
}

cmd_status() {
  if daemon_running; then
    echo "daemon: RUNNING (pid $(cat "$DAEMON_PID_FILE"))"
  else
    echo "daemon: NOT RUNNING (start via Task Scheduler 'agent-caffeine-daemon' or logoff/logon)"
  fi
  local holders
  holders=$(count_holders)
  echo "holders: $holders"
  if [ "$holders" -gt 0 ]; then
    if daemon_running; then
      echo "sleep-inhibit: ACTIVE (daemon injecting F15+cursor while holders>0)"
    else
      echo "sleep-inhibit: INACTIVE (holders present but daemon down — will NOT prevent sleep)"
    fi
  else
    echo "sleep-inhibit: idle (no holders)"
  fi
  local f
  for f in "$HOLDERS_DIR"/*; do
    [ -e "$f" ] || continue
    echo "  - $(basename "$f")"
  done
}

case "${1:-}" in
acquire)
  shift
  cmd_acquire "${1:-}"
  ;;
release)
  shift
  cmd_release "${1:-}"
  ;;
status) cmd_status ;;
reap)
  reap
  echo "holders: $(count_holders)"
  ;;
janitor) cmd_janitor ;;
*)
  echo "usage: agent-caffeine {acquire|release|status|reap|janitor} [token]" >&2
  exit 1
  ;;
esac
