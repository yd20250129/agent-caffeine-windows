<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>agent-caffeine daemon: persistent sleep-inhibit while holders exist. Started at user logon, runs in interactive desktop session so SendKeys/Cursor actually resets Windows IdleTimer.</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>NMCORP\N196893</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>NMCORP\N196893</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <!--
      Queue: 前のインスタンスが動いていても /Run を捨てずに次を待たせる。
      IgnoreNew だと State=Running 残留の zombie 時に /Run が黙って捨てられて
      復旧できない罠があった (2026-08-03 実測)。ensure_daemon 側で End→Run
      するので Queue でも重複起動はほぼ無く、万一並列起動しても daemon.ps1 の
      pid guard で二重目は即 exit する。Parallel も可だが RestartOnFailure と
      競合して複数プロセスが一瞬立ち上がる race があり、ログが混乱するので Queue にする。
    -->
    <MultipleInstancesPolicy>Queue</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "C:\Users\N196893\agent-caffeine-windows\src\daemon.ps1"</Arguments>
    </Exec>
  </Actions>
</Task>
